{
  "name": "player-de-aulas",
  "version": "0.1.6",
  "private": true,
  "description": "Player local de aulas do Telegram para Windows.",
  "author": "Player de Aulas",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "check": "node --check main.cjs && node --check telegram.cjs && node --check preload.cjs && node --check renderer.js && node --check notebook.js && node --check theme.js && node --check playback.js && node --check phone.cjs && node --check updates.cjs && node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64",
    "postdist": "node tests/package-check.cjs && node scripts/prune-releases.cjs",
    "releases:prune": "node scripts/prune-releases.cjs",
    "release": "node scripts/publish-release.cjs"
  },
  "dependencies": {
    "teleproto": "1.232.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.playerdeaulas.app",
    "productName": "Player de Aulas",
    "directories": { "output": "release/${version}" },
    "files": ["*.cjs", "*.js", "*.html", "*.css", "assets/**/*", "demo.mp4", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": { "artifactName": "Player-de-Aulas-Instalar.exe", "oneClick": false, "allowToChangeInstallationDirectory": true, "include": "build/installer.nsh", "installerLanguages": ["pt_BR"], "perMachine": false, "createDesktopShortcut": true, "runAfterFinish": true, "deleteAppDataOnUninstall": false }
  }
}
